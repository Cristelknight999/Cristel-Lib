{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "${homepage}",
        "issues": "${issues}",
        "sources": "${sources}"
    },
    "license": "${license}",
    "icon": "pack.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "de.cristelknight.cristellib.CristelLibFabric"
        ],
        "client": [
            "de.cristelknight.cristellib.client.CristelLibFabricClient"
        ],
        "cristellib": [
            "de.cristelknight.cristellib.api.BuiltInAPI"
        ],
        "modmenu": [
            "de.cristelknight.cristellib.client.ModMenuIntegration"
        ]
    },
    "mixins": [
        "cristellib.mixins.json",
        "cristellib.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_min_version}",
        "fabric-api": ">=${fabric_api_version}",
        "minecraft": ">=${minecraft_version}"
    }
}