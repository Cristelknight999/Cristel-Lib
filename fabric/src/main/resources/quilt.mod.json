{
	"schema_version": 1,
	"quilt_loader": {
		"group": "${group}",
		"id": "${mod_id}",
		"version": "${version}",
		"metadata": {
			"name": "${mod_name}",
			"description": "${description}",
			"contributors": {
				"${mod_author}": "Owner"
			},
			"contact": {
				"homepage": "${homepage}",
				"issues": "${issues}",
				"sources": "${sources}"
			},
			"license": "${license}",
			"icon": "pack.png"
		},
		"intermediate_mappings": "net.fabricmc:intermediary",
		"entrypoints": {
			"main": "de.cristelknight.cristellib.CristelLibFabric",
			"client": "de.cristelknight.cristellib.client.CristelLibFabricClient",
			"cristellib": "de.cristelknight.cristellib.api.BuiltInAPI",
			"modmenu": "de.cristelknight.cristellib.client.ModMenuIntegration"
		},
		"depends": [
			{
				"id": "quilt_loader",
				"versions": ">=${quilt_loader_version}"
			},
			{
				"id": "fabric-api",
				"versions": ">=${fabric_api_version}"
			},
			{
				"id": "minecraft",
				"versions": ">=${minecraft_version}"
			}
		],
		"jars": [
			"META-INF/jars/jankson-1.2.3.jar"
		]
	},
	"mixin": [
		"cristellib.mixins.json",
		"cristellib.fabric.mixins.json"
	]
}
